# Long-running Telegram command bot. Enable on WSL2 (systemd on) with:
#   sudo cp ops/systemd/earn-telegram.service /etc/systemd/system/
#   sudo systemctl enable --now earn-telegram
[Unit]
Description=Earn Telegram command bot (long polling, single chat)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/momentum
ExecStart=/usr/bin/env bash /home/user/momentum/ops/envwrap.sh telegram -- /home/user/momentum/.venv/bin/python -m ops.telegram_bot
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
