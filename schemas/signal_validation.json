{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal validation verdict (spec section 7, step 9)",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "confidence", "thesis", "reasons", "counter_evidence",
               "invalidation", "horizon_hours", "suggested"],
  "properties": {
    "verdict": { "enum": ["valid", "invalid", "uncertain"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "thesis": { "type": "string", "minLength": 20, "maxLength": 800 },
    "reasons": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "counter_evidence": {
      "type": "array", "minItems": 0, "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "invalidation": { "type": "string", "minLength": 10, "maxLength": 300 },
    "horizon_hours": { "type": "integer", "minimum": 1, "maximum": 168 },
    "suggested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction"],
      "properties": {
        "direction": { "enum": ["up", "down", "risk", "hold"] },
        "pair": { "type": ["string", "null"], "maxLength": 20 },
        "conviction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "cited_feature_keys": {
      "type": "array", "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    }
  }
}
