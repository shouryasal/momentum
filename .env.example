# Earn secrets — copy to .env, chmod 600. NEVER commit .env (gitignored + gitleaks).
# ops/.env must be a symlink to this repo-root .env (docker compose interpolation).

# Anthropic Console API key — the ONLY secret the research/review runs receive
ANTHROPIC_API_KEY=

# Telegram: one ops bot, one chat. Freqtrade's own telegram stays disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Freqtrade REST API (localhost-only; per-bot passwords, shared JWT secret)
FT_API_PASSWORD_A=
FT_API_PASSWORD_B=
FT_JWT_SECRET=

# Binance API keys — EMPTY through the paper phase. Read-only testnet keys in week 3.
# One key per bot; permissions: Enable Reading + Enable Spot & Margin Trading ONLY;
# withdrawals disabled; IP-restricted once on a static address; rotated every 90 days.
BINANCE_KEY_A=
BINANCE_SECRET_A=
BINANCE_KEY_B=
BINANCE_SECRET_B=

# Container file ownership on WSL2 (defaults are fine for the first user)
HOST_UID=1000
HOST_GID=1000

# Optional: healthchecks.io dead-man's-switch URL (silence-is-an-alert backstop)
HEALTHCHECKS_URL=

# Optional: rclone remote name for cloud backup copies
BACKUP_RCLONE_REMOTE=
