# Earn secrets — copy to .env, chmod 600. NEVER commit .env (gitignored + gitleaks).
# `ops/setup.sh` does the copy, generates the three EARN_* secrets and creates the
# ops/.env symlink docker compose interpolates from.
#
# Which job sees which variable is decided by ops/envwrap.sh, not by this file. Check it
# with:   ops/envwrap.sh --print-allowlist <job>
# Nothing here is read by a job that is not allowlisted for it.

# ---------------------------------------------------------------- Claude credentials
# Two ways to authenticate, selected by EARN_CLAUDE_AUTH_MODE / models.yaml auth.claude_mode:
#
#   subscription  the Claude Max subscription, via `claude setup-token`. No metered
#                 spend. This is the default and what the schedules assume.
#   api_key       the Anthropic Console API key. Metered; bounded by
#                 models.yaml auth.api_key_monthly_cap_usd.
#   auto          subscription first, API key as fallback. In this mode envwrap hands
#                 jobs the key as EARN_FALLBACK_ANTHROPIC_API_KEY — a name the Claude
#                 CLI cannot pick up implicitly, so a fallback is always a deliberate,
#                 journaled switch.
#
# Get the token with:  claude setup-token   (it is a long-lived OAuth token, not a password)
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic Console API key (sk-ant-...). Leave empty on a subscription-only host.
ANTHROPIC_API_KEY=

# subscription | api_key | auto   — unknown values fall back to subscription.
# The console rewrites this line when you change auth.claude_mode in the UI.
EARN_CLAUDE_AUTH_MODE=subscription

# ---------------------------------------------------------------- local models
# Ollama endpoint. Empty = auto-detect (127.0.0.1, the WSL gateway, the resolv.conf
# nameserver, host.docker.internal). Explicit URLs must be loopback or private.
OLLAMA_BASE_URL=

# ---------------------------------------------------------------- console
# Generated by ops/setup.sh. These two are in NO envwrap allowlist and NO automated run
# ever sees them: EARN_CONSOLE_SECRET signs var/state/mode.json and the config bless
# digest, EARN_CONSOLE_TOKEN is the console login token.
EARN_CONSOLE_SECRET=
EARN_CONSOLE_TOKEN=

# HMAC key for proposal/change approvals. Allowlisted for the `telegram` job only; the
# in-container proposal loader verifies signatures made with it.
EARN_APPROVAL_KEY=

# ---------------------------------------------------------------- Telegram
# One ops bot, one chat. Freqtrade's own telegram integration stays disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- Freqtrade
# REST API (localhost-only; per-bot passwords, shared JWT secret)
FT_API_PASSWORD_A=
FT_API_PASSWORD_B=
FT_JWT_SECRET=

# ---------------------------------------------------------------- Binance
# EMPTY through the paper phase. One key per bot; permissions: Enable Reading + Enable
# Spot & Margin Trading ONLY; withdrawals disabled; IP-restricted once on a static
# address; rotated every 90 days. Allowlisted only for `reconcile` and `preflight` —
# never for a model job (runs/common.py:guard_env hard-fails if one ever leaked).
BINANCE_KEY_A=
BINANCE_SECRET_A=
BINANCE_KEY_B=
BINANCE_SECRET_B=

# ---------------------------------------------------------------- host
# Container file ownership on WSL2 (defaults are fine for the first user)
HOST_UID=1000
HOST_GID=1000

# Optional: healthchecks.io dead-man's-switch URL (silence-is-an-alert backstop)
HEALTHCHECKS_URL=

# Optional: rclone remote name for cloud backup copies (see backup.dest / backup.mirror_dest)
BACKUP_RCLONE_REMOTE=
