# The repo is edited from Windows (OneDrive) and executed on WSL2 ext4. Without this
# file, git's autocrlf can land CRLF in a shell script, and bash then reports
# "/usr/bin/env bash^M: bad interpreter" — a failure mode that looks like a missing
# interpreter and wastes an evening. Every executable text file is pinned to LF.

* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.service   text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
.env.example text eol=lf
ops/crontab text eol=lf

# PowerShell is run by Windows itself; CRLF is correct there.
*.ps1       text eol=crlf

# Binary payloads git must never touch.
*.feather   binary
*.xlsx      binary
*.sqlite    binary
*.db        binary
*.png       binary
*.jpg       binary
*.ico       binary
*.woff2     binary
